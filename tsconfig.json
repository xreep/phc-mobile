{
  "extends": "expo/tsconfig.base",
  "compilerOptions": {
    "strict": true,
    // Jest's globals (describe/it/expect) are ambient, so nothing imports them
    // and TS never pulls @types/jest in on its own. Listing it here is what
    // type-checks the test files: jest-expo transpiles via Babel and strips
    // types without checking them, so `tsc --noEmit` is the only gate on tests.
    "types": ["jest", "expo/types"],
    "paths": {
      "@/*": [
        "./src/*"
      ],
      "@/assets/*": [
        "./assets/*"
      ]
    }
  },
  "include": [
    "**/*.ts",
    "**/*.tsx",
    ".expo/types/**/*.ts",
    "expo-env.d.ts"
  ],
  // `relay/` is the Cloudflare Worker (its own package.json, tsconfig and Workers types);
  // the app's `tsc --noEmit` must not compile it under jest/expo types. Setting `exclude`
  // replaces the default list, so `node_modules` is restated.
  "exclude": ["node_modules", "relay"]
}
