{
  "name": "phc-sos-relay",
  "version": "0.1.0",
  "private": true,
  "description": "Provider-agnostic emergency alert relay for the PHC app (Cloudflare Worker).",
  "type": "module",
  "scripts": {
    "test": "vitest run",
    "test:watch": "vitest",
