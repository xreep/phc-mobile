    "deploy": "wrangler deploy"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "5.20260920.1",
    "typescript": "6.0.3",
    "vitest": "5.0.1",
    "wrangler": "4.135.0"
  },
  "engines": {
    "node": ">=22.12"
  }
}
