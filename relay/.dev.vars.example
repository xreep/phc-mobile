# Local secrets for `npm run dev` (wrangler dev). Copy to `.dev.vars` — which is gitignored —
# and fill in. Production uses `wrangler secret put <NAME>`, never this file.
#
# Leave a line empty to leave that adapter unconfigured.

TELEGRAM_BOT_TOKEN=
# Mandatory for the webhook (503 without it); pass the same value to setWebhook as secret_token.
TELEGRAM_WEBHOOK_SECRET=
# Unset = "textbelt" (free tier, one SMS per day).
TEXTBELT_KEY=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM=
# Shared key the app sends as X-PHC-Key. Optional for Telegram + free Textbelt; mandatory before
# TEXTBELT_KEY or TWILIO_* (the relay answers 503 otherwise). Ships in the app bundle, so not a real secret.
RELAY_APP_KEY=
