# Local secrets for `npm run dev` (wrangler dev). Copy to `.dev.vars` — which is gitignored —
# and fill in. Production uses `wrangler secret put <NAME>`, never this file.
#
# Leave a line empty to leave that adapter unconfigured.

TELEGRAM_BOT_TOKEN=
TELEGRAM_WEBHOOK_SECRET=
# Unset = "textbelt" (free tier, one SMS per day).
TEXTBELT_KEY=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM=
# Optional shared key the app sends as X-PHC-Key. Not a real secret (it ships in the app bundle).
RELAY_APP_KEY=
